    <h1 class="font-display text-h1 font-black uppercase text-headline text-shadow-poster">
      This synapse doesn't connect.
    </h1>
    <p class="mt-6 text-lead">
      <a href="/" class="text-link underline underline-offset-4 hover:decoration-2">Go to the home page</a>
    </p>
  </section>
</Base>
