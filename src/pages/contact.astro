---
import Base from '../layouts/Base.astro';

const email = 'neurosciencesoc@src.gla.ac.uk';
const topics = ['General enquiry', 'Events', 'Sponsorship & collabs', 'Welfare', 'Complaint'];
const socials = [
  { name: 'Instagram', handle: '@guneurosci', href: 'https://instagram.com/guneurosci' },
  { name: 'Facebook', handle: 'guneurosoc', href: 'https://www.facebook.com/guneurosoc' },
  { name: 'X', handle: '@NeuroscienceSoc', href: 'https://twitter.com/NeuroscienceSoc' },
];
---

<Base
  title="Contact"
  description="Contact the Glasgow University Neuroscience Society (GU NeuroSoc) by email at neurosciencesoc@src.gla.ac.uk, or on Instagram, Facebook and X."
>
  <div class="container-site section">
    <h1 class="headline text-h1">Contact</h1>

    <section aria-labelledby="email-heading" class="card mt-12 max-w-2xl">
      <h2 id="email-heading" class="font-display text-h3 font-extrabold">Email the committee</h2>
      <p class="mt-3">
        Our email address is <a href={`mailto:${email}`} class="font-semibold break-all">{email}</a>
      </p>

      <label for="topic" class="mt-6 block font-semibold">What's it about?</label>
      <select
        id="topic"
        class="mt-2 min-h-11 w-full rounded-card border-2 border-border-strong bg-surface px-3 text-text sm:w-auto"
      >
        {topics.map((t) => <option value={t}>{t === 'General enquiry' ? 'General' : t}</option>)}
      </select>

      <p class="mt-4 text-sm text-text-muted">
        Making a complaint? Read the <a href="/complaints">complaints process</a> first.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a id="mailto-link" class="btn-primary" href={`mailto:${email}`}>Email us</a>
        <button type="button" id="copy-email" class="btn-secondary" data-js-only>Copy email</button>
        <span id="copy-status" aria-live="polite" class="text-sm font-semibold"></span>
      </div>
    </section>

    <section aria-labelledby="welfare-heading" class="mt-12">
      <h2 id="welfare-heading" class="font-display text-h2 font-extrabold uppercase">Welfare</h2>
      <p class="mt-4">Welfare Officer: {'{{WELFARE_EMAIL}}'}</p>
    </section>

    <section aria-labelledby="social-heading" class="mt-12">
      <h2 id="social-heading" class="font-display text-h2 font-extrabold uppercase">Social media</h2>
      <p class="mt-4">Updates are posted on Instagram.</p>
      <ul class="mt-4 flex flex-wrap gap-4" role="list">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="noopener" class="btn-secondary">
                {s.name} <span class="font-sans text-sm text-text-muted">{s.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<script>
  const email = 'neurosciencesoc@src.gla.ac.uk';
  const topic = document.getElementById('topic') as HTMLSelectElement;
  const link = document.getElementById('mailto-link') as HTMLAnchorElement;
  const copy = document.getElementById('copy-email') as HTMLButtonElement;
  const status = document.getElementById('copy-status') as HTMLElement;

  // encodeURIComponent, not URLSearchParams: mailto needs %20 for spaces, not "+".
  const update = () => {
    const subject = encodeURIComponent(`[Website] ${topic.value}`);
    const body = encodeURIComponent('Hi GU NeuroSoc committee,\n\n');
    link.href = `mailto:${email}?subject=${subject}&body=${body}`;
  };
  topic.addEventListener('change', update);
  update();

  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      status.textContent = 'Copied';
    } catch {
      status.textContent = 'Could not copy. The address is shown above.';
    }
  });
</script>
