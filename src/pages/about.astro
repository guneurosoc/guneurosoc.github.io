---
import Base from '../layouts/Base.astro';
import ActionPotential from '../components/fx/ActionPotential.astro';

const activities = ['Pub quizzes', 'Game nights', 'Weekly catch-ups', 'Assignment help', 'Exam revision'];
const link = 'text-link underline underline-offset-4 hover:decoration-2';
---

<Base
  title="About"
  description="About the Glasgow University Neuroscience Society: our aims, what we do, who can join, and our commitment to equality, diversity and inclusion."
>
  <div class="container-site section">
    <h1 class="headline text-h1 font-black">About</h1>
    <p class="mt-6 max-w-prose text-lead">
      GU NeuroSoc is open to all University of Glasgow students, whether you're studying neuroscience or just keenly
      interested. It's a place to meet like-minded people and make lifelong friends at all levels of the university.
    </p>

    <section aria-labelledby="aims" class="mt-16">
      <h2 id="aims" class="headline text-h2 font-extrabold">Our aims</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-2" role="list">
        <li class="card">
          <h3 class="font-display text-h3 font-extrabold">Bring people together</h3>
          <p class="mt-3">
            We bring together people who are interested in neuroscience, particularly within the School of Psychology
            &amp; Neuroscience, and we mix across year groups.
          </p>
        </li>
        <li class="card">
          <h3 class="font-display text-h3 font-extrabold">Make friends</h3>
          <p class="mt-3">We run informal socials so friendships and network contacts can form naturally.</p>
        </li>
        <li class="card">
          <h3 class="font-display text-h3 font-extrabold">Support with coursework</h3>
          <p class="mt-3">
            We offer coursework support in a less formal setting, especially for younger students.
          </p>
        </li>
        <li class="card">
          <h3 class="font-display text-h3 font-extrabold">Keep up with research</h3>
          <p class="mt-3">
            We raise awareness of current neuroscience research, so members can keep up with advances and
            breakthroughs.
          </p>
        </li>
      </ol>
    </section>

    <div class="mt-16"><ActionPotential /></div>

    <section aria-labelledby="what-we-do" class="mt-16">
      <h2 id="what-we-do" class="headline text-h2 font-extrabold">What we do</h2>
      <p class="mt-6 max-w-prose">We hold regular social events, including:</p>
      <ul class="mt-4 flex flex-wrap gap-3" role="list">
        {activities.map((a) => <li class="chip">{a}</li>)}
        <li class="chip">…and more</li>
      </ul>
      <p class="mt-6 max-w-prose">
        What's coming up is posted on Instagram:
        <a href="https://instagram.com/guneurosci" rel="noopener" class={link}>@guneurosci</a>.
      </p>
    </section>

    <section aria-labelledby="who-can-join" class="mt-16">
      <h2 id="who-can-join" class="headline text-h2 font-extrabold">Who can join</h2>
      <div class="prose-site mt-6">
        <p>
          <strong class="font-semibold">Full membership</strong> is for registered University of Glasgow students.
        </p>
        <p>
          <strong class="font-semibold">Associate membership</strong> is for people who aren't students. Associate
          members don't have voting rights, and make up no more than 20% of the membership.
        </p>
        <p><a href="/join">How to join</a></p>
      </div>
    </section>

    <section aria-labelledby="equal-opportunities" class="mt-16">
      <h2 id="equal-opportunities" class="headline text-h2 font-extrabold">Equal opportunities</h2>
      <div class="prose-site mt-6">
        <p>
          We treat everyone with respect and promote equality, diversity and inclusion. There is no place in the
          society for discrimination, harassment or bullying.
        </p>
        <p>Read our <a href="/code-of-conduct">Code of Conduct</a>.</p>
      </div>
    </section>
  </div>
</Base>
