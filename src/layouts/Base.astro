---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PREVIEW } from '../../site.config';

import type { Props as HeadProps } from '../components/Head.astro';
type Props = HeadProps;
const props = Astro.props;
---

<html lang="en">
  <head>
    <Head {...props} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-text">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-cta px-6 py-3 font-semibold text-cta-text focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      >Skip to content</a
    >
    {
      PREVIEW && (
        <p role="status" class="bg-surface-2 px-4 py-1 text-center text-sm text-text">
          Preview — this site isn't launched yet
        </p>
      )
    }
    <Header />
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../components/fx/fx';
    </script>
  </body>
</html>
