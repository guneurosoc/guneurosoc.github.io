---
import { PREVIEW } from '../../site.config';
import { OG_PAGES } from '../og-pages';

export interface Props {
  /** Page name, e.g. "About". Omit on Home for the full society title. */
  title?: string;
  description: string;
  /** Image path. Default: /og/<slug>.png for this page (src/pages/og), else /og/default.png. */
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// "/" → home, "/about/" → about; the 404 page renders at /404.html or any missing path.
const slug = Astro.url.pathname.replace(/^\/|\/$|\.html$/g, '') || 'home';
const ogImage = Astro.props.ogImage ?? `/og/${slug in OG_PAGES ? slug : 'default'}.png`;
const ogAlt = `GU NeuroSoc — ${title ?? 'Glasgow University Neuroscience Society'}`;
const site = Astro.site!;
const fullTitle = title
  ? `${title} — GU NeuroSoc`
  : 'GU NeuroSoc — Glasgow University Neuroscience Society';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;

const csp =
  "default-src 'self'; img-src 'self' data: blob:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; worker-src 'self'; frame-src 'none'; form-action 'none'";

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Glasgow University Neuroscience Society',
  alternateName: 'GU NeuroSoc',
  url: new URL('/', site).href,
  email: 'neurosciencesoc@src.gla.ac.uk',
  logo: new URL('/logo.png', site).href,
  sameAs: [
    'https://instagram.com/guneurosci',
    'https://www.facebook.com/guneurosoc',
    'https://twitter.com/NeuroscienceSoc',
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="Content-Security-Policy" content={csp} />
<script is:inline src="/theme.js"></script>
<title>{fullTitle}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{(PREVIEW || noindex) && <meta name="robots" content="noindex" />}
<meta name="theme-color" content="#0a0716" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="GU NeuroSoc" />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- JSON-LD is a data block, not executed, so script-src 'self' does not block it. -->
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
