---
// Placeholder avatar until committee photos exist: a decorative "neuron" (soft body, dendrites
// with node dots) in one brand colour on a surface-2 circle. Purely decorative, so aria-hidden.
export interface Props {
  /** Position in the committee list; picks the colour. */
  index: number;
}
const colours = [
  'var(--color-hot-pink)',
  'var(--color-electric-blue)',
  'var(--color-sky)',
  'var(--color-deep-violet)',
  'var(--color-lavender)',
];
const c = colours[Astro.props.index % colours.length];
// Dendrite end points around a body at (50,50).
const ends = [
  [18, 22],
  [82, 20],
  [86, 62],
  [58, 88],
  [16, 70],
];
---

<svg viewBox="0 0 100 100" width="96" height="96" aria-hidden="true" focusable="false" class="shrink-0">
  <circle cx="50" cy="50" r="50" fill="var(--surface-2)"></circle>
  <g stroke={c} stroke-width="3" stroke-linecap="round" fill="none">
    {ends.map(([x, y]) => <path d={`M50 50 Q${(50 + x) / 2 + 6} ${(50 + y) / 2 - 6} ${x} ${y}`} />)}
  </g>
  {ends.map(([x, y]) => <circle cx={x} cy={y} r="4.5" fill={c} />)}
  <circle cx="50" cy="50" r="15" fill={c} opacity="0.35"></circle>
  <circle cx="50" cy="50" r="9" fill={c}></circle>
</svg>
